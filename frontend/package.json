{
  "name": "ai-search-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 搜索平台前端（Vite + React + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
